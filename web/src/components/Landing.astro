---
import { Font, Image } from 'astro:assets';
import { latestRelease } from '../release';
import androidHome from '../assets/android/01-home.png';
import appleOptionsEn from '../assets/apple/2-options-en.png';
import appleOptionsAr from '../assets/apple/2-options-ar.png';

interface Props { lang: 'en' | 'ar' }
const { lang } = Astro.props;
const ar = lang === 'ar';

const repo = 'haithamassoli/NaqiHalalVideoFilter';
const android = await latestRelease(repo, '.apk');
const playUrl = 'https://play.google.com/store/apps/details?id=com.haithamassoli.naqi';
const appStoreId = '6798173054';
const appStoreUrl = `https://apps.apple.com/app/naqi-halal-video-filter/id${appStoreId}`;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const abs = (path: string) => new URL(`${base}/${path}`, Astro.site).href;
const enUrl = abs('');
const arUrl = abs('ar/');
const pageUrl = ar ? arUrl : enUrl;
const ogImage = abs(ar ? 'og-ar.png' : 'og-en.png');

const t = {
  en: {
    title: 'Naqi: remove music and cover faces in videos, on your device',
    description:
      'Naqi removes music from videos while keeping speech, and covers faces and flagged scenes. It runs on your device, with no upload and no account. For Android, iPhone, iPad and Mac, with Windows coming.',
    otherLang: 'العربية',
    nav: { download: 'Download', browser: 'Browser' },
    chip: ['On-device', 'Private', 'Free'],
    headline: 'Keep the talk. Lose the music.',
    lead: 'Naqi removes the music from a video and keeps the voices. It can also cover faces and flagged scenes. Everything runs on your device, and the original file stays as it was.',
    speech: 'Speech stays',
    music: 'Music goes',
    ctaDownload: 'Download Naqi',
    ctaBrowser: 'Filter in your browser',
    whatTitle: 'Three filters. Use one or all.',
    features: [
      ['music', 'Remove music', 'A separation model keeps only the voices, or voices plus sound effects. Parts with no music are left untouched.'],
      ['face', 'Cover faces', 'Faces are tracked through the whole video. Cover everyone, women or men, with a blur, a solid colour or grayscale.'],
      ['scene', 'Cover flagged scenes', 'An optional scene check covers the whole frame while it is on. You set how strict it is, from 0 to 100.'],
    ],
    caveat: 'Filtering can miss a face or a scene. Watch the result before you share it.',
    privacyTitle: 'Your videos never leave your device.',
    privacy:
      'No account, no analytics, no upload. Naqi goes online only to download a video from a link you give it, and in the APK version to check for a new version.',
    downloadTitle: 'Download',
    downloadLead: 'Free on every platform. The filtering is the same everywhere.',
    soon: 'Coming soon',
    beta: 'Beta',
    platforms: {
      android: ['Android', 'Android 10 or newer, 64-bit ARM. Reads MP4, MKV, WebM, MP3 and M4A.'],
      ios: ['iPhone and iPad', 'iOS 18 or iPadOS 18 and newer. Reads MP4, MOV and M4V.'],
      mac: ['Mac', 'macOS 15 and newer. Drag a video onto the app, save it to a folder.'],
      windows: ['Windows', 'Windows 10 or 11, x64. Reads MP4, MOV, MKV, WebM, AVI and more.'],
    },
    googlePlay: 'Google Play',
    apk: 'APK',
    appStore: 'App Store',
    macAppStore: 'Mac App Store',
    msi: 'Installer (MSI)',
    androidNote: 'The APK adds link downloads, sharing into Naqi and updates from GitHub, which Google Play does not allow.',
    browserTitle: 'Watching in the browser?',
    browserLead: 'These free extensions filter in real time as you browse. Other developers make them; they are not part of Naqi.',
    extensions: {
      haramblur: ['HaramBlur', 'Blurs faces and indecent images and videos on most websites while you browse.'],
      musicless: ['Musicless', 'Removes most of the background music from YouTube videos and keeps the voices.'],
    },
    website: 'Website',
    footer: 'Naqi (نقي) means pure.',
    code: 'Source code',
    alt: {
      androidHome: 'Naqi on Android: pick a video and choose what to filter',
      appleOptions: 'Naqi on iPad: filtering options',
    },
  },
  ar: {
    title: 'نقي: احذف الموسيقى واحجب الوجوه في الفيديو، على جهازك',
    description:
      'يحذف نقي الموسيقى من الفيديو ويُبقي الكلام، ويحجب الوجوه والمشاهد المخلّة. يعمل على جهازك دون رفع أي ملف ودون حساب. لأندرويد وآيفون وآيباد وماك، وويندوز قريبًا.',
    otherLang: 'English',
    nav: { download: 'التنزيل', browser: 'المتصفح' },
    chip: ['على الجهاز', 'خاص', 'مجاني'],
    headline: 'أبقِ الكلام، واحذف الموسيقى.',
    lead: 'يحذف نقي الموسيقى من الفيديو ويُبقي الأصوات البشرية، ويحجب الوجوه والمشاهد المخلّة إن أردت. كل شيء يجري على جهازك، والملف الأصلي يبقى كما هو.',
    speech: 'الكلام يبقى',
    music: 'الموسيقى تُحذف',
    ctaDownload: 'حمّل نقي',
    ctaBrowser: 'فلترة داخل المتصفح',
    whatTitle: 'ثلاثة فلاتر، استخدم واحدًا أو كلها.',
    features: [
      ['music', 'حذف الموسيقى', 'نموذج فصل يُبقي الأصوات البشرية وحدها، أو الأصوات مع المؤثرات الصوتية. والمقاطع الخالية من الموسيقى تبقى كما هي.'],
      ['face', 'حجب الوجوه', 'تُتتبَّع الوجوه على امتداد الفيديو كله. احجب الجميع أو النساء أو الرجال، بالتمويه أو بلون صلب أو بالتدرّج الرمادي.'],
      ['scene', 'حجب المشاهد المخلّة', 'فحص اختياري للمشاهد يغطي الإطار كاملًا طوال اشتغاله. وأنت تحدّد درجة صرامته من 0 إلى 100.'],
    ],
    caveat: 'قد تفوت الفلترة وجهًا أو مشهدًا، فشاهد النتيجة قبل أن تشاركها.',
    privacyTitle: 'فيديوهاتك لا تغادر جهازك.',
    privacy:
      'لا حساب ولا تحليلات ولا رفع للملفات. لا يتصل نقي بالإنترنت إلا لتنزيل فيديو من رابط تعطيه إياه، وفي نسخة APK للبحث عن إصدار جديد.',
    downloadTitle: 'التنزيل',
    downloadLead: 'مجاني على كل المنصات، والفلترة واحدة في كل مكان.',
    soon: 'قريبًا',
    beta: 'تجريبي',
    platforms: {
      android: ['أندرويد', 'أندرويد 10 فأحدث، بمعالج ARM بمعمارية 64 بت. يقرأ MP4 وMKV وWebM وMP3 وM4A.'],
      ios: ['آيفون وآيباد', 'iOS 18 أو iPadOS 18 فأحدث. يقرأ MP4 وMOV وM4V.'],
      mac: ['ماك', 'macOS 15 فأحدث. اسحب الفيديو إلى التطبيق، واحفظه في مجلد تختاره.'],
      windows: ['ويندوز', 'ويندوز 10 أو 11، بمعمارية x64. يقرأ MP4 وMOV وMKV وWebM وAVI وغيرها.'],
    },
    googlePlay: 'Google Play',
    apk: 'ملف APK',
    appStore: 'App Store',
    macAppStore: 'Mac App Store',
    msi: 'المثبّت (MSI)',
    androidNote: 'نسخة APK تضيف التنزيل من الروابط، ومشاركة الفيديو إلى نقي، والتحديث من GitHub، وهذه لا يسمح بها Google Play.',
    browserTitle: 'تشاهد في المتصفح؟',
    browserLead: 'هذه الإضافات المجانية تفلتر لحظيًا أثناء التصفح. يطوّرها مطوّرون آخرون، وليست جزءًا من نقي.',
    extensions: {
      haramblur: ['HaramBlur', 'يموّه الوجوه والصور والمقاطع المخلّة في معظم المواقع أثناء التصفح.'],
      musicless: ['Musicless', 'يحذف معظم الموسيقى الخلفية من فيديوهات يوتيوب ويُبقي الأصوات.'],
    },
    website: 'الموقع',
    footer: 'نقي: الطاهر الخالص.',
    code: 'الشيفرة المصدرية',
    alt: {
      androidHome: 'نقي على أندرويد: اختر فيديو وحدّد ما تريد فلترته',
      appleOptions: 'نقي على آيباد: خيارات الفلترة',
    },
  },
}[lang];

const appleOptions = ar ? appleOptionsAr : appleOptionsEn;
const sep = ar ? '، ' : ', ';
const apkMeta = android.version
  ? `${android.version}${android.sizeMb ? `${sep}${android.sizeMb} MB` : ''}`
  : 'GitHub';
// ponytail: four API calls per build (two languages, two platforms); set GITHUB_TOKEN if the limit bites.
const windows = await latestRelease(repo, '.msi', /^windows-v\d/, true);

// Stroke icons in the app's style, drawn on a 24px grid.
const icon = {
  music: '<path d="M9 18V6l10-2v10"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="14" r="2.5"/><path d="M3 3l18 18"/>',
  face: '<path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/>',
  scene: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 3l18 18"/>',
  android: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
  ios: '<rect x="4.5" y="2.5" width="15" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
  mac: '<rect x="4.5" y="5" width="15" height="10" rx="1.5"/><path d="M2.5 19h19"/>',
  windows: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M9 20h6M12 16v4"/>',
  browser: '<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 9h18M6.5 6.5h.01M9 6.5h.01"/>',
};
type Link = { label: string; href?: string; meta?: string };
const platforms: { key: keyof typeof t.platforms; badge?: string; links: Link[]; note?: string }[] = [
  { key: 'android', links: [{ label: t.googlePlay, href: playUrl }, { label: t.apk, href: android.url, meta: apkMeta }], note: t.androidNote },
  { key: 'ios', links: [{ label: t.appStore, href: appStoreUrl }] },
  { key: 'mac', links: [{ label: t.macAppStore, href: `${appStoreUrl}?platform=mac` }] },
  windows.version
    ? { key: 'windows', badge: t.beta, links: [{ label: t.msi, href: windows.url, meta: windows.version.replace(/^windows-/, '') }] }
    : { key: 'windows', links: [{ label: t.soon }] },
];
const extensions: { key: keyof typeof t.extensions; site: string; source: string; links: Link[] }[] = [
  {
    key: 'haramblur', site: 'https://haramblur.com/', source: 'https://github.com/alganzory/HaramBlur',
    links: [
      { label: 'Chrome', href: 'https://chrome.google.com/webstore/detail/haramblur/pbcoegikffnadpahojjhgdladmmddeji' },
      { label: 'Firefox', href: 'https://addons.mozilla.org/addon/haramblur/' },
    ],
  },
  {
    key: 'musicless', site: `https://musicless.ieasybooks.com/${lang}/`, source: 'https://github.com/ieasybooks/musicless',
    links: [
      { label: 'Chrome · Edge · Brave', href: 'https://chromewebstore.google.com/detail/musicless/fllcnhpmoanojfbncfpdencchjlgphco' },
      { label: 'Firefox', meta: t.soon },
    ],
  },
];

// A soundtrack drawn as bars: speech keeps its bars, music bars flatten on load.
// Deterministic so every build draws the same wave.
const bars = Array.from({ length: 72 }, (_, i) => {
  const music = (i >= 10 && i < 28) || (i >= 46 && i < 60);
  const wobble = Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.45));
  const h = music ? 0.55 + 0.45 * Math.abs(Math.sin(i * 0.9)) : 0.15 + 0.7 * wobble;
  return { music, h: +h.toFixed(3) };
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: ar ? 'نقي' : 'Naqi',
  alternateName: ar ? 'Naqi' : 'نقي',
  description: t.description,
  url: pageUrl,
  image: ogImage,
  inLanguage: lang,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: `Android 10+, iOS 18+, iPadOS 18+, macOS 15+${windows.version ? ', Windows 10+' : ''}`,
  installUrl: [playUrl, appStoreUrl],
  downloadUrl: [playUrl, appStoreUrl, android.url, ...(windows.version ? [windows.url] : [])],
  sameAs: [playUrl, appStoreUrl, `https://github.com/${repo}`],
  ...(android.version && { softwareVersion: android.version.replace(/^v/, '') }),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Haitham Assoli' },
};
---

<!doctype html>
<html lang={lang} dir={ar ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta name="theme-color" content="#F5F7F3" />
    <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ar ? 'نقي' : 'Naqi'} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={ar ? 'ar_AR' : 'en_US'} />
    <meta property="og:locale:alternate" content={ar ? 'en_US' : 'ar_AR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.headline} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.headline} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Font cssVariable="--font-readex" preload />
  </head>
  <body>
    <header class="bar wrap">
      <a class="brand" href={ar ? `${base}/ar/` : `${base}/`}>
        <img src={`${base}/favicon.svg`} alt="" width="30" height="30" />
        <span>{ar ? 'نقي' : 'Naqi'}</span>
      </a>
      <nav>
        <a href="#download">{t.nav.download}</a>
        <a href="#browser">{t.nav.browser}</a>
        <a class="lang" href={ar ? `${base}/` : `${base}/ar/`} hreflang={ar ? 'en' : 'ar'} lang={ar ? 'en' : 'ar'}>{t.otherLang}</a>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <div class="hero-text">
          <p class="chip">{t.chip.map((c, i) => <>{i > 0 && <span aria-hidden="true">·</span>}{c}</>)}</p>
          <h1>{t.headline}</h1>
          <p class="lead">{t.lead}</p>

          <figure class="wave" aria-hidden="true">
            <svg viewBox={`0 0 ${bars.length * 10} 100`} preserveAspectRatio="none">
              {bars.map((b, i) => (
                <rect
                  class={b.music ? 'm' : 's'}
                  x={i * 10 + 2}
                  y={50 - b.h * 48}
                  width="6"
                  height={b.h * 96}
                  rx="3"
                  style={b.music ? `--d:${(i % 18) * 18}ms` : undefined}
                />
              ))}
            </svg>
            <figcaption>
              <span class="key s">{t.speech}</span>
              <span class="key m">{t.music}</span>
            </figcaption>
          </figure>

          <div class="ctas">
            <a class="btn primary" href="#download">{t.ctaDownload}</a>
            <a class="btn" href="#browser">{t.ctaBrowser}</a>
          </div>
        </div>

        <div class="hero-shots">
          <Image class="tablet" src={appleOptions} alt={t.alt.appleOptions} widths={[480, 720, 960]} sizes="(min-width: 960px) 34vw, 70vw" loading="eager" fetchpriority="high" />
          <Image class="phone" src={androidHome} alt={t.alt.androidHome} widths={[240, 360, 480]} sizes="(min-width: 960px) 14vw, 30vw" loading="eager" />
        </div>
      </section>

      <section class="wrap block" aria-labelledby="what">
        <h2 id="what">{t.whatTitle}</h2>
        <ul class="card rows">
          {t.features.map(([k, name, body]) => (
            <li>
              <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icon[k as keyof typeof icon]} /></span>
              <div><h3>{name}</h3><p>{body}</p></div>
            </li>
          ))}
        </ul>
        <p class="fine">{t.caveat}</p>
      </section>

      <section class="wrap block">
        <div class="privacy">
          <h2>{t.privacyTitle}</h2>
          <p>{t.privacy}</p>
        </div>
      </section>

      <section id="download" class="wrap block" aria-labelledby="download-title">
        <h2 id="download-title">{t.downloadTitle}</h2>
        <p class="sub">{t.downloadLead}</p>
        <div class="grid">
          {platforms.map((p) => (
            <article class:list={['card', 'tile', { soon: !p.links[0].href }]}>
              <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icon[p.key]} /></span>
              <h3>{t.platforms[p.key][0]} {p.badge && <span class="tag">{p.badge}</span>}</h3>
              <p>{t.platforms[p.key][1]}</p>
              {p.note && <p class="fine">{p.note}</p>}
              <div class="links">
                {p.links.map((l, i) => l.href
                  ? <a class:list={['btn', { primary: i === 0 }]} href={l.href}>{l.label}{l.meta && <small>{l.meta}</small>}</a>
                  : <span class="btn off">{l.label}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="browser" class="wrap block" aria-labelledby="browser-title">
        <h2 id="browser-title">{t.browserTitle}</h2>
        <p class="sub">{t.browserLead}</p>
        <div class="grid two">
          {extensions.map((e) => (
            <article class="card tile">
              <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icon.browser} /></span>
              <h3>{t.extensions[e.key][0]}</h3>
              <p>{t.extensions[e.key][1]}</p>
              <div class="links">
                {e.links.map((l, i) => l.href
                  ? <a class:list={['btn', { primary: i === 0 }]} href={l.href}>{l.label}</a>
                  : <span class="btn off">{l.label} <small>{l.meta}</small></span>)}
              </div>
              <p class="fine"><a href={e.site}>{t.website}</a> · <a href={e.source}>GitHub</a></p>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="wrap">
      <p>{t.footer}</p>
      <p>
        {t.code}:{' '}
        <a href={`https://github.com/${repo}/tree/main/apps/android`}>{t.platforms.android[0]}</a>{sep}
        <a href={`https://github.com/${repo}/tree/main/apps/apple`}>{ar ? 'آبل' : 'Apple'}</a>{sep}
        <a href={`https://github.com/${repo}/tree/main/apps/windows`}>{t.platforms.windows[0]}</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f5f7f3;
    --card: #ecf1ed;
    --mist: #e3ece7;
    --line: #c9d6cf;
    --ink: #10201c;
    --forest: #1e6b58;
    --mint: #6fd9b6;
    --muted: #4d5f59;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-readex), system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.6;
    font-weight: 350;
  }
  h1, h2, h3 { line-height: 1.15; margin: 0; font-weight: 600; text-wrap: balance; }
  p { margin: 0; }
  a { color: var(--forest); }
  :focus-visible { outline: 3px solid var(--mint); outline-offset: 3px; border-radius: 6px; }
  img { display: block; max-width: 100%; height: auto; }
  .wrap { width: min(1120px, 100% - 2.5rem); margin-inline: auto; }
  [id] { scroll-margin-top: 1.5rem; }
</style>

<style>
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-block: 1.25rem; }
  .brand { display: flex; gap: 0.55rem; align-items: center; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 1.2rem; }
  .brand img { border-radius: 8px; }
  nav { display: flex; align-items: center; gap: 0.25rem; }
  nav a { color: var(--ink); text-decoration: none; padding: 0.4rem 0.8rem; border-radius: 999px; font-size: 0.95rem; }
  nav a:hover { background: var(--mist); }
  nav .lang { border: 1px solid var(--line); margin-inline-start: 0.4rem; }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 5vw, 4rem) clamp(3rem, 7vw, 5.5rem);
  }
  .chip {
    display: inline-flex; gap: 0.6rem; padding: 0.35rem 1rem; margin-bottom: 1.4rem;
    border: 1px solid var(--line); border-radius: 999px; background: var(--mist);
    color: var(--forest); font-size: 0.85rem; font-weight: 500; letter-spacing: 0.02em;
  }
  .chip span { color: #9fb5ab; }
  h1 { font-size: clamp(2.5rem, 5.8vw, 4.4rem); letter-spacing: -0.02em; font-weight: 600; }
