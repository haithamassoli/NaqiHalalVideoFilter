{
  "sourceLanguage" : "en",
  "strings" : {
    "done_end_card_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتهي الفيديو بخاتمة نقي، ويمكنك إيقافها من «الإعدادات»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video ends with the Naqi card. You can turn it off in Settings."
          }
        }
      }
    },
    "settings_end_card_desc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف شعار نقي لثانيتين في نهاية الفيديو."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a 2-second Naqi card at the end of the video."
          }
        }
      }
    },
    "settings_end_card_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خاتمة نقي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Naqi end card"
          }
        }
      }
    },
    "licenses_ffmpeg_terms": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم استيراد WebM الإصدار المصغّر من FFmpegKit وFFmpeg بترخيص LGPL-3.0. نص الترخيص مرفق بالتطبيق، وتتوفر تفاصيل الحزمة عبر الرابط أدناه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WebM import uses the LGPL-3.0 FFmpegKit min build and FFmpeg. License text is bundled with the app. Package details are available below."
          }
        }
      }
    },
    "licenses_ffmpeg_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "FFmpegKit / FFmpeg"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FFmpegKit / FFmpeg"
          }
        }
      }
    },
    "settings_server_desc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفيديوهات التي مدتها 10 دقائق فأكثر تُرسل إلى سيرفر نقي ليزيل الموسيقى ويحدد الأشخاص لتغبيش الجسم بسرعة أكبر بكثير، ثم تُحذف فورًا. إذا تعذّر السيرفر يقوم جهازك بذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos of 10 minutes or more are sent to Naqi's server, which removes music and finds people for body blur far faster, then deletes them. If the server is unavailable, your device does it."
          }
        }
      }
    },
    "settings_server_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام السيرفر للفيديوهات الطويلة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the server for long videos"
          }
        }
      }
    },
    "stage_converting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
