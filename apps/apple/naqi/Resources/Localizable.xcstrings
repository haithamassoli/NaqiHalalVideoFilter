    "opt_body_precise_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفلترة أبطأ لأن نموذجًا إضافيًا يبحث عن الأجسام. يحجب الوجه وحدود الجسم فقط ويُبقي الخلفية واضحة. يُحجب من لم يتضح تصنيفه؛ وقد تُحجب الصورة كاملة عند تعذّر تحديد الجسم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtering is slower because an extra model looks for bodies. Covers faces and only the body's outline, keeping the background clear. Unknown people are covered; the whole picture may be covered when a body cannot be identified."
          }
        }
      }
    },
    "opt_person_title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجسم كاملًا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whole body"
          }
        }
      }
    },
    "opt_person_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفلترة أبطأ لأن نموذجًا إضافيًا يبحث عن الأجسام. يحجب الوجه والجسم بمستطيل يشمل ما حوله. يُحجب من لم يتضح تصنيفه؛ وقد تُحجب الصورة كاملة عند تعذّر تحديد الجسم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtering is slower because an extra model looks for bodies. Covers faces and bodies with a rectangle that includes what is around them. Unknown people are covered; the whole picture may be covered when a body cannot be identified."
          }
        }
      }
    },
