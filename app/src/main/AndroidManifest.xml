<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground service for the (long-running) on-device filtering job. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Model downloader only ([ModelDownloader]); all inference is on-device and nothing is uploaded. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime permission on API 33+; still requested at runtime before starting a job. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Pre-Q only: saving the filtered copy into public Movies/Naqi needs legacy write access (also
         requested at runtime). API 29+ uses scoped MediaStore and needs no permission, so cap at 28. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- android:localeConfig lists the locales we ship (English default, Arabic). It is what
         surfaces Naqi in the Android 13+ per-app language picker (Settings > Apps > Naqi >
         Language), letting the user pick Arabic without changing the system language. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NaqiHalalVideoFilter">

        <!-- Declare the FGS type on WorkManager's own service via manifest merge. The runtime
             type in ForegroundInfo must be a subset of these. mediaProcessing = API 35+, dataSync = API 34. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync|mediaProcessing"
            tools:node="merge" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NaqiHalalVideoFilter"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
