<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground service for the (long-running) on-device filtering job. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Model downloader only ([ModelDownloader]); all inference is on-device and nothing is uploaded. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Runtime permission on API 33+; still requested at runtime before starting a job. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No storage permission: minSdk 29 means every install uses scoped MediaStore, and an app's own
         contributions to Movies/Naqi need no permission to write or read back. -->

    <!-- android:localeConfig lists the locales we ship (English default, Arabic). It is what
         surfaces Naqi in the Android 13+ per-app language picker (Settings > Apps > Naqi >
         Language), letting the user pick Arabic without changing the system language. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NaqiHalalVideoFilter">

        <!-- Declare the FGS type on WorkManager's own service via manifest merge. The runtime
             type in ForegroundInfo must be a subset of these. mediaProcessing = API 35+, dataSync = API 34. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync|mediaProcessing"
            tools:node="merge" />

        <!-- singleTask so a share reuses the running instance instead of stacking a second copy on top
             of a job the user is watching. Accepted cost (PRD "Entry point"): a share pulls the user
             into Naqi's task, and Back does not return to the source app. The fix is Seal's separate
             dialog-themed activity; cut for v1. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NaqiHalalVideoFilter"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share a link: Naqi downloads it, then filters it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Share a video file: filtered directly, no download, source untouched. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
