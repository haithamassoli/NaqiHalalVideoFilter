    <string name="battery_card_title">Speed up background processing</string>
    <string name="battery_card_body">Allow Naqi to run without battery restrictions so your videos keep downloading and filtering at full speed after you leave the app. You can change this anytime in Settings.</string>
    <string name="battery_card_allow">Allow</string>
    <string name="battery_card_later">Not now</string>
    <string name="settings_eyebrow">Settings</string>
