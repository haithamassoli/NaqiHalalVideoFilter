<resources>

    <!-- ============================================================
         App
         ============================================================ -->
    <string name="app_name">Naqi</string>

    <!-- ============================================================
         Pick / onboarding — step 1, PickOpsScreen
         ============================================================ -->

    <!-- Trust-seal pill at the very top; the two halves are joined by a "·" drawn in code. Tight space, keep short. -->
    <string name="pick_seal_on_device">On-device</string>
    <!-- Was "Offline". Naqi now downloads links the user shares, so "Offline" became a false claim;
         "Private" says the thing that is still true and is what the seal was ever about. -->
    <string name="pick_seal_private">Private</string>

    <!-- Brand lockup under the droplet mark. BRAND: identical value in every locale, do not translate. -->

    <!-- Two-line privacy promise under the wordmark; \n is a real line break in the rendered text. -->
    <string name="pick_tagline">Filtering happens on your device.\nYour videos never leave your phone.</string>

    <!-- Pick-source card. Title is one line with ellipsis; "File selected" covers a provider that exposes
         no name, and says nothing about video because an audio pick lands here too. -->
    <string name="pick_video_none">Pick a video or audio file</string>
    <string name="pick_video_selected">File selected</string>
    <string name="pick_video_change">Tap to change</string>
    <!-- Accepted containers; the format names are proper nouns and stay Latin in every locale. -->
    <string name="pick_video_formats">MP4 · MKV · WebM · MP3 · M4A</string>

    <!-- The other source: a link the user pastes. The placeholder carries the "or", so the field needs no
         section label of its own; the second string is the trailing icon button's content description. -->
    <string name="pick_link_hint">Or paste a video link</string>
    <string name="pick_link_action">Download link</string>

    <!-- Section label above the operations card. Sentence case: SectionHeader() renders it as written. -->
    <string name="pick_eyebrow_choose">Choose what to filter</string>

    <!-- Operation cards. -->
    <string name="pick_op_music_title">Remove music</string>
    <string name="pick_op_music_desc">Strip the soundtrack, keep dialogue.</string>
    <string name="pick_op_faces_title">Censor faces</string>
    <!-- %1$s = the current Who choice (opt_who_everyone/_women/_men). The toggle on step 1 says *whether*
         faces are censored; this line says *which*, so step 1 can never state something Options contradicts. -->
    <string name="pick_op_faces_desc">%1$s · scene censoring is optional.</string>
    <!-- Shown while the toggle is OFF. It describes what turning it on would do; the substituted line
         above asserts what IS happening, which an off row must not do (ToggleTile does not dim `desc`). -->
    <string name="pick_op_faces_desc_off">Blur faces; scene censoring is optional.</string>

    <!-- Overflow menu on the pick screen; content description of the "⋮" button. -->
    <string name="action_more">More</string>

    <!-- Primary CTA: advances to the options screen. -->
    <string name="action_continue">Continue</string>

    <!-- Check-marked reassurance line directly under the Continue button. -->
    <string name="pick_reassurance">Original file is never changed.</string>

    <!-- Device diagnostics, shown on the about screen (ORT providers + per-model smoke results). -->
    <string name="pick_diag_title">Device runtime</string>
    <string name="pick_diag_running">Running model smoke…</string>
    <!-- %1$s = comma-joined ONNX Runtime execution-provider names, or "—" when the list is empty. -->
    <string name="pick_diag_eps">EPs: %1$s</string>
    <!-- Layout template, one row per model. %1$s = status glyph (✓ / – / ✗), %2$s = model name, %3$s = diagnostic detail. -->
    <string name="pick_diag_model_line">%1$s %2$s · %3$s</string>

    <!-- ============================================================
         Durations — shared by the up-front estimate (options) and the live ETA (jobs).
         Whole strings rather than a number glued to a unit, so a locale keeps its own
         digits, word order and unit words. %1$d = hours, %2$d = minutes.
         ============================================================ -->
    <string name="dur_under_min">under a minute</string>
    <string name="dur_min">%1$d min</string>
    <string name="dur_h_min">%1$d h %2$d min</string>
    <string name="dur_sec">%1$d s</string>
    <!-- Download stats: "45 MB / 120 MB", "3.1 MB/s". The sizes arrive already localized. -->
    <string name="dl_done_of_total">%1$s / %2$s</string>
    <string name="dl_speed">%1$s/s</string>

    <!-- ============================================================
         Options — step 2, OptionsScreen
         ============================================================ -->

    <!-- Content description of the top-bar back arrow. The glyph is NaqiIcons.ArrowBack, which auto-mirrors
         in RTL, so no arrow belongs in this string any more. -->
    <string name="action_back">Back</string>
    <string name="opt_title">Options</string>

    <!-- Censor-faces section. -->
    <string name="opt_section_censor_faces">Censor faces</string>
    <!-- Who is first in the section: it is the largest decision here, and Strictness/Style/Blur only tune
         what it selected. The segment labels are also substituted into pick_op_faces_desc on step 1. -->
    <string name="opt_who_title">Who</string>
    <string name="opt_who_desc">Which faces get covered. Scene censoring is controlled separately.</string>
    <string name="opt_who_everyone">Everyone</string>
    <string name="opt_who_women">Women</string>
    <string name="opt_who_men">Men</string>
    <!-- The desc has to state the cost plainly: on ordinary footage this covers most of the video, and
         the output is a re-encoded file, so it cannot be undone the way a browser blur can. -->
    <string name="opt_whole_frame_title">Cover the whole frame</string>
    <string name="opt_coverage_title">Coverage</string>
    <string name="opt_cover_face">Face</string>
    <string name="opt_cover_body">Body</string>
    <string name="opt_cover_frame">Frame</string>
    <string name="opt_body_warning">Covers rectangles around selected people, including their faces. Processing may take longer. Unclassified people are covered too.</string>
    <string name="opt_whole_frame_desc">Covers the entire picture while a censored face is on screen, not just the face. Most of the video usually ends up covered.</string>
    <string name="opt_nsfw_title">Censor flagged scenes</string>
    <string name="opt_nsfw_desc">Uses the NSFW model to cover the whole frame when a scene is flagged.</string>
    <string name="opt_strictness_title">Strictness</string>
    <string name="opt_strictness_desc">How eagerly whole scenes are censored. Face blurring is never affected.</string>
    <string name="opt_censor_style_title">Censor style</string>
    <string name="opt_censor_style_desc">Blur the area, or cover it with a solid color.</string>
    <string name="opt_style_blur">Blur</string>
    <string name="opt_style_solid">Solid</string>
    <!-- Spoken by TalkBack for the color swatches; never shown on screen. -->
    <string name="opt_solid_gray">Gray</string>
    <string name="opt_solid_black">Black</string>
    <string name="opt_solid_white">White</string>
    <string name="opt_solid_navy">Navy</string>
    <string name="opt_solid_green">Green</string>
    <string name="opt_blur_amount_title">Blur amount</string>
    <string name="opt_blur_amount_desc">How heavy the blur is on faces and censored scenes.</string>
    <string name="opt_grayscale_title">Grayscale</string>
    <string name="opt_grayscale_desc">Also drains the color out of censored areas.</string>

    <!-- Remove-music section. -->
    <string name="opt_section_remove_music">Remove music</string>
    <!-- Keep-stems rows. The wire values "vocals"/"vocals_other" are NOT localizable and are not resources. -->
    <string name="opt_keep_vocals_title">Voices only</string>
    <string name="opt_keep_vocals_desc">Keeps dialogue and singing; drops music and sound effects.</string>
    <string name="opt_keep_vocals_other_title">Voices + sounds</string>
    <string name="opt_keep_vocals_other_desc">Also keeps sound effects and ambience; some music may leak.</string>

    <!-- action_hide/action_show are the two states of one affordance (the about screen's licence block). -->
    <string name="action_hide">Hide</string>
    <string name="action_show">Show</string>

    <!-- Language picker (API 33+). Opens system per-app language settings. -->
    <string name="opt_language">Language</string>

    <!-- Primary CTA: enqueues the filtering job. -->
    <string name="action_start">Start</string>

    <!-- Numeric readout beside a slider title. %1$d = the 0–100 value. -->
    <string name="opt_slider_value">%1$d</string>

    <!-- Up-front time estimate above Start. %1$s = a dur_* string. Deliberately worded as a FLOOR:
         every measurement behind it came from a flagship, so "at least" is the only honest framing. -->
    <string name="opt_eta_floor">Estimated at least %1$s on this phone.</string>

    <!-- Shown above a disabled Start when a job is already running; Naqi runs one job at a time. -->
    <string name="opt_job_running">A job is already running. Wait for it to finish, or cancel it first.</string>

    <!-- Confirm dialog shown when the estimate is long (Eta.CONFIRM_THRESHOLD_MS). A warning, never a
         refusal — its confirm button is action_start and its dismiss is action_cancel. %1$s = a dur_* string. -->
    <string name="dlg_long_job_title">This will take a while</string>
    <string name="dlg_long_job_body">This video is estimated at ~%1$s at least. Keep the phone plugged in — Naqi keeps working in the background, but the phone will be busy the whole time and the job can\'t be paused, only cancelled.</string>

    <!-- ============================================================
         Jobs / library — step 3, JobsScreen
         Also reuses action_cancel, action_open and action_share (see Notifications).
         ============================================================ -->

    <!-- Bottom-bar action that resets the flow back to step 1. -->
    <string name="jobs_new_job">Filter another video</string>

    <!-- Top-bar title of step 3: the queue, the running job and the library are all "what Naqi is doing". -->
    <string name="jobs_title">Activity</string>

    <!-- Empty state inside the job card when nothing is running, succeeded or failed. -->
    <!-- Phase 2 resume: shown on a failed long job whose finished segments are still on disk. -->
    <string name="jobs_resume_hint">The finished parts of this job were kept. Resuming picks up where it stopped.</string>
    <string name="action_resume">Resume</string>
    <string name="jobs_none_running">No job running.</string>

    <!-- Library list. "Movies/Naqi" is a real on-disk path — keep it Latin, untranslated. -->
    <string name="jobs_library">Library</string>
    <string name="jobs_library_empty">Filtered files are saved to Movies/Naqi, audio to Music/Naqi.</string>
    <!-- Library overflow → Delete. %1$s = the file name. -->
    <string name="jobs_delete_title">Delete this file?</string>
    <string name="jobs_delete_body">%1$s will be removed from this device and can’t be recovered.</string>
    <string name="jobs_delete_failed">Couldn’t delete the file — remove it from your gallery instead.</string>

    <!-- Progress card. jobs_stage_starting fills the instant before the worker publishes its first stage_* value. -->
    <string name="jobs_stage_starting">Starting…</string>
    <!-- %1$d = 0–100 progress; %% is a literal percent sign. -->
    <string name="jobs_progress_percent">%1$d%%</string>
    <!-- Live remaining time, refined from this device's observed rate. %1$s = a dur_* string.
         Hidden entirely until the worker has enough throughput to mean it (KEY_ETA_MS == 0). -->
    <string name="jobs_eta_remaining">~%1$s remaining</string>

    <!-- Success card. -->
    <string name="jobs_saved_label">Saved</string>
    <!-- %1$s = the video length, e.g. 2:26. -->
    <string name="jobs_saved_meta">Saved · %1$s</string>
    <!-- Beside a Delete button on the saved card, which asks before deleting the source video. -->
    <string name="jobs_original_still_here">The original is still on your device</string>

    <!-- Header of the system share sheet. -->
    <string name="jobs_share_chooser_title">Share video</string>

    <!-- Prepare to post (PublishSheet). Platform names are labels only; limits live in PublishPreset. -->
    <string name="action_prepare_publish">Prepare to post</string>
    <string name="preset_whatsapp_status">WhatsApp Status</string>
    <string name="preset_x_free">X</string>
    <string name="preset_instagram_story">Instagram Story</string>
    <string name="preset_instagram_reels">Instagram Reels</string>
    <string name="preset_tiktok">TikTok</string>
    <string name="preset_snapchat_story">Snapchat Story</string>
    <string name="preset_telegram">Telegram</string>
    <string name="preset_messenger">Messenger</string>
    <string name="preset_custom">Custom</string>
    <string name="publish_custom_max">Longest part: %1$s</string>
    <string name="publish_needs_split">Longer than %1$s, so it will be split into parts, cut at the nearest keyframe.</string>
    <string name="publish_as_is">Fits as is. It will be shared without changes.</string>
    <string name="publish_split">Prepare parts</string>
    <string name="publish_preparing">Preparing parts…</string>
    <string name="publish_part">Part %1$d</string>
    <string name="publish_part_duration">Part %1$d · %2$s</string>
    <string name="publish_share_all">Share all</string>
    <string name="publish_delete_parts">Delete parts</string>
    <string name="publish_parts_saved">Parts are saved in Movies/Naqi/Parts.</string>
    <string name="publish_failed">Couldn’t prepare the parts</string>
    <string name="jobs_open_failed">No app can open this file.</string>

    <!-- File-size subtitle on a library row. %1$.1f = gigabytes, %1$.0f = megabytes. -->
    <string name="jobs_size_gb">%1$.1f GB</string>
    <string name="jobs_size_mb">%1$.0f MB</string>

    <!-- ============================================================
         Dialogs and toasts — MainActivity
         ============================================================ -->

    <!-- Toasts after the delete-original flow resolves. -->
    <string name="dlg_original_deleted">Original deleted</string>
    <string name="dlg_original_kept">Original kept</string>
    <string name="dlg_delete_original_failed">Couldn’t delete the original — remove it from your gallery instead.</string>

    <!-- Confirm-delete dialog. %1$s = the file name of the filtered copy; it may fall back to dlg_delete_original_fallback_name. -->
    <string name="dlg_delete_original_title">Delete the original?</string>
    <string name="dlg_delete_original_body">The filtered copy (%1$s) stays in Movies/Naqi. The original video will be removed from this device and can’t be recovered.</string>
    <string name="dlg_delete_original_fallback_name">this video</string>
    <!-- Buttons of that dialog. Distinct from action_delete_original, the notification action. -->
    <string name="action_delete">Delete</string>
    <string name="action_keep">Keep</string>

    <!-- ============================================================
         Failure messages — the Preflight taxonomy, resolved in JobsScreen
         ============================================================ -->
    <string name="err_drm">This video is copy-protected (DRM), so it can’t be filtered.</string>
    <string name="err_unreadable">This file couldn’t be opened. It may be damaged or in a format this device doesn’t support.</string>
    <string name="err_no_video">This file has no video track.</string>
    <string name="err_no_audio">This video has no audio track, so there’s no music to remove.</string>
    <!-- The 2 GB figure is a fixed constant, not a format arg. -->
    <string name="err_low_space">Not enough free space. Filtering needs room for a temporary copy plus about 2 GB.</string>
    <string name="err_unsupported_codec">This video uses a codec this device can’t decode.</string>
    <string name="err_out_of_space">The device ran out of space while saving the filtered copy.</string>
    <!-- Catch-all. Also the JobsScreen fallback when a FAILED job carried no message. -->
    <string name="err_generic">Filtering failed.</string>

    <!-- Download failures (M4). Kept separate from the filtering taxonomy above: a download fails for
         reasons filtering never sees, and "this video uses a codec…" would be nonsense for any of them. -->
    <string name="err_low_space_download">Not enough free space to download this video. Free up some space and try again.</string>
    <string name="err_download_unsupported">This video can\'t be downloaded. It may be private, removed, need an account, or be on a site Naqi doesn\'t support.</string>
    <string name="err_download_geo">This video isn\'t available in your country.</string>
    <string name="err_download_rate_limited">The site is limiting downloads right now. Try again in a few minutes.</string>
    <string name="err_download_forbidden">The site refused the download. Try again in a few minutes.</string>
    <string name="err_download_extractor">Naqi couldn\'t read this video, even after updating its downloader. Try again later.</string>
    <string name="err_download_network">Download failed. Check your connection and try again.</string>
    <string name="err_download_generic">Download failed.</string>

    <!-- ============================================================
         Notifications — job foreground service and the done notification.
         The action_* keys here are shared with JobsScreen and must keep these exact names.
         ============================================================ -->
    <string name="job_channel_name">Video filtering</string>
    <string name="job_channel_desc">Progress for on-device filtering jobs</string>
    <string name="job_notif_title">Filtering video</string>
    <string name="action_cancel">Cancel</string>
    <!-- Notification second line once an ETA exists. %1$s = a stage_* string, %2$s = a dur_* string.
         The notification is the only surface a user sees during a multi-hour job — the app is closed
         and the phone is locked — so the estimate has to reach here, not just the jobs screen. -->
    <string name="job_notif_stage_eta">%1$s · ~%2$s remaining</string>
    <!-- Shown while a non-AAC source's audio is transcoded so the segmented job can resume. -->
    <string name="stage_preparing">Preparing audio</string>
    <string name="stage_analyzing">Pass 1 — analyzing</string>
    <string name="stage_rendering">Pass 2 — rendering</string>
    <string name="stage_separating">Removing music</string>
    <string name="stage_muxing">Finishing up</string>
    <string name="stage_downloading">Downloading</string>

    <!-- ============================================================
         Share sheet (M4) — shown when a link or a video is shared into Naqi
         ============================================================ -->
    <!-- Fallback heading when the source exposes no title at all. -->
    <string name="share_untitled">Shared video</string>
    <!-- Section labels. -->
    <string name="share_eyebrow_quality">Quality</string>
    <string name="share_eyebrow_filters">Filters</string>
    <string name="share_advanced_options">Advanced options</string>
    <string name="share_hide_advanced_options">Hide advanced options</string>
    <string name="share_quality_best">Best</string>
    <!-- Resolution labels are format names; they stay Latin in every locale. -->
    <string name="share_quality_1080">1080p</string>
    <string name="share_quality_720">720p</string>
    <string name="share_quality_480">480p</string>
    <string name="share_quality_audio">Audio only</string>
    <string name="action_download">Download</string>
    <string name="action_filter">Filter</string>
    <string name="action_retry">Retry</string>
    <!-- Shown on both link entry points, so the wording must not assume either one: a toast when a
         share intent carries no link, and inline under the pick screen's field when what was TYPED
         is not one. "in what you shared" read as a bug under a field the user typed into. -->
    <string name="share_no_url">That doesn\'t look like a video link.</string>
    <string name="share_already_queued">Already in the queue.</string>

    <!-- Share queue (M4). -->
    <string name="queue_eyebrow">Queue</string>
    <string name="queue_state_pending_download">Waiting to download</string>
    <string name="queue_state_waiting_download">Queued behind the current download</string>
    <string name="queue_state_pending_filter">Waiting to filter</string>
    <string name="queue_state_waiting_filter">Queued behind the current video</string>
    <string name="queue_state_filtering">Filtering</string>
    <string name="queue_state_done">Saved</string>
    <string name="queue_state_failed">Failed</string>
    <string name="queue_dismiss">Dismiss</string>
    <string name="queue_clear_failed">Clear failed</string>

    <!-- ============================================================
         App update card (UpdateCard, on the pick screen). Naqi ships from GitHub Releases, so it
         checks for and installs its own updates.
         ============================================================ -->
    <!-- %1$s = the new version, e.g. 1.3. -->
    <string name="update_available">Naqi %1$s available</string>
    <!-- %1$s = download size, %2$s = the version installed now. -->
    <string name="update_sub">%1$s · you have %2$s</string>
    <string name="update_action">Update</string>
    <!-- %1$s = the version being downloaded. Also the title of the system download notification. -->
    <string name="update_downloading">Downloading Naqi %1$s</string>
    <!-- %1$s = bytes so far, %2$s = total, both already formatted with their unit. -->
    <string name="update_bytes">%1$s of %2$s</string>
    <!-- %1$s = the version waiting to be installed. -->
    <string name="update_ready">Naqi %1$s ready to install</string>
    <string name="update_ready_sub">Your videos and settings are kept.</string>
    <string name="update_install">Install</string>
    <string name="update_failed">Download failed</string>
    <string name="update_failed_sub">Check your connection and try again.</string>
    <string name="update_retry">Retry</string>
    <string name="update_dismiss">Dismiss</string>

    <!-- ============================================================
         About / open-source licences (M4). AboutScreen.
         ============================================================ -->
    <string name="about_title">Settings &amp; about</string>
    <!-- %1$s = version name, %2$d = version code. -->
    <string name="about_version">Version %1$s (%2$d)</string>
    <string name="about_license">Licensed under GPL-3.0-or-later.</string>
    <!-- Entry point on the pick screen. -->
    <string name="about_open">Settings &amp; about</string>

    <string name="about_eyebrow_downloader">Downloader</string>
    <string name="about_eyebrow_licenses">Open source</string>
    <!-- %1$s = a yt-dlp version string like 2026.07.04, or about_ytdlp_unknown. -->
    <string name="about_ytdlp_version">yt-dlp %1$s</string>
    <string name="about_ytdlp_unknown">not updated yet</string>
    <string name="about_ytdlp_desc">Sites change how they serve video every few weeks. Naqi checks for a new downloader once a week; update here if a link stops working.</string>
    <string name="about_update">Check for update</string>
    <string name="about_updating">Updating…</string>
    <string name="about_update_ok">Downloader is up to date.</string>
