    <string name="onb_get_started">Get started</string>
    <string name="onb_welcome_title">Clean up any video</string>
    <string name="onb_welcome_body">Naqi filters your videos the way you want, in a few taps.</string>
    <string name="onb_feat_blur">Blur faces automatically</string>
    <string name="onb_feat_music">Remove music, keep the voices</string>
