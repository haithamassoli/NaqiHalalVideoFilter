<resources>

    <!-- ============================================================
         App
         ============================================================ -->
    <string name="app_name">نقي</string>

    <!-- ============================================================
         Pick / onboarding — step 1, PickOpsScreen
         ============================================================ -->

    <!-- Trust-seal pill at the very top; the two halves are joined by a "·" drawn in code. Tight space, keep short. -->
    <string name="pick_seal_on_device">على الجهاز</string>
    <!-- Was "بلا إنترنت" (Offline) — no longer true now that Naqi downloads shared links. -->
    <string name="pick_seal_private">خصوصية تامة</string>

    <!-- Brand lockup under the droplet mark. BRAND: identical value in every locale, do not translate. -->
    <string name="pick_wordmark_ar">نقي</string>
    <string name="pick_wordmark_latin">Naqi</string>

    <!-- Two-line privacy promise under the wordmark; \n is a real line break in the rendered text. -->
    <string name="pick_tagline">تتم الفلترة على جهازك.\nلا تغادر مقاطعك هاتفك أبدًا.</string>

    <!-- Pick-video card. Title is one line with ellipsis; "Video selected" covers a provider that exposes no name. -->
    <string name="pick_video_none">اختر فيديو</string>
    <string name="pick_video_selected">تم اختيار الفيديو</string>
    <string name="pick_video_change">انقر للتغيير</string>
    <!-- Accepted containers; the format names are proper nouns and stay Latin in every locale. -->
    <string name="pick_video_formats">MP4 · MKV · WebM</string>

    <!-- Section label above the two operation cards. Arabic has no case; a short phrase replaces the English caps. -->
    <string name="pick_eyebrow_choose">اختر ما تريد فلترته</string>

    <!-- Operation cards. -->
    <string name="pick_op_music_title">إزالة الموسيقى</string>
    <string name="pick_op_music_desc">تُزيل الموسيقى التصويرية وتُبقي الحوار.</string>
    <string name="pick_op_women_title">حجب النساء</string>
    <string name="pick_op_women_desc">تُموّه وجوه النساء والمشاهد المُخالفة.</string>

    <!-- Overflow menu on the pick screen; content description of the "⋮" button. -->
    <string name="action_more">المزيد</string>

    <!-- Primary CTA: advances to the options screen. -->
    <string name="action_continue">متابعة</string>

    <!-- Check-marked reassurance line directly under the Continue button. -->
    <string name="pick_reassurance">لا يُمسّ الملف الأصلي أبدًا.</string>

    <!-- Diagnostics footer (ORT provider + per-model smoke results). The label is translated, the runtime tokens are not. -->
    <string name="pick_diag_title">بيئة التشغيل على الجهاز</string>
    <string name="pick_diag_running">جارٍ اختبار النماذج…</string>
    <!-- %1$s = comma-joined ONNX Runtime execution-provider names, or "—" when the list is empty. -->
    <string name="pick_diag_eps">موفّرات التنفيذ: %1$s</string>
    <!-- Layout template, one row per model. %1$s = status glyph (✓ / – / ✗), %2$s = model name, %3$s = diagnostic detail. -->
    <string name="pick_diag_model_line">%1$s %2$s · %3$s</string>

    <!-- ============================================================
         Options — step 2, OptionsScreen
         ============================================================ -->

    <!-- Content description of the top-bar back arrow; the glyph itself auto-mirrors, so it is not in the text. -->
    <string name="action_back">رجوع</string>
    <string name="opt_title">الخيارات</string>

    <!-- Censor-women section. Arabic has no case; a short phrase replaces the English caps. -->
    <string name="opt_section_censor_women">حجب النساء</string>
    <string name="opt_strictness_title">الصرامة</string>
    <string name="opt_strictness_desc">مدى سهولة حجب المشهد كاملًا. لا يتأثّر تمويه الوجوه بهذا الإعداد.</string>
    <string name="opt_blur_amount_title">شدّة التمويه</string>
    <string name="opt_blur_amount_desc">مدى قوّة التمويه على الوجوه والمشاهد المحجوبة.</string>
    <string name="opt_grayscale_title">تدرّج الرمادي</string>
    <string name="opt_grayscale_desc">يسحب الألوان أيضًا من المناطق المحجوبة.</string>

    <!-- Remove-music section. Arabic has no case; a short phrase replaces the English caps. -->
    <string name="opt_section_remove_music">إزالة الموسيقى</string>
    <!-- Keep-stems rows. The wire values "vocals"/"vocals_other" are NOT localizable and are not resources. -->
    <string name="opt_keep_vocals_title">الأصوات البشرية فقط</string>
    <string name="opt_keep_vocals_desc">يُبقي الحوار والغناء؛ ويحذف الموسيقى والمؤثرات الصوتية.</string>
    <string name="opt_keep_vocals_other_title">الأصوات البشرية + المؤثرات</string>
    <string name="opt_keep_vocals_other_desc">يُبقي أيضًا المؤثرات الصوتية وأصوات المحيط؛ وقد يتسرّب شيء من الموسيقى.</string>

    <!-- Collapsible Advanced card (censor-only). action_hide/action_show are the two states of one affordance. -->
    <string name="opt_advanced_title">خيارات متقدّمة</string>
    <string name="action_hide">إخفاء</string>
    <string name="action_show">إظهار</string>
    <string name="opt_blur_unknown_faces_title">تمويه الوجوه غير المُصنَّفة</string>
    <string name="opt_blur_unknown_faces_desc">يحجب الوجوه التي يتعذّر تحديد جنسها. مُعطَّل افتراضيًا لأنه يُموّه الرجال أيضًا.</string>

    <!-- Language picker (API 33+). Opens system per-app language settings. -->
    <string name="opt_language">اللغة</string>

    <!-- Primary CTA: enqueues the filtering job. -->
    <string name="action_start">بدء</string>

    <!-- Numeric readout beside a slider title. %1$d = the 0–100 value. -->
    <string name="opt_slider_value">%1$d</string>

    <!-- ============================================================
         Durations — shared by the up-front estimate (options) and the live ETA (jobs).
         Whole strings rather than a number glued to a unit, so Arabic keeps its own digits
         and word order. %1$d = hours, %2$d = minutes.
         ============================================================ -->
    <string name="dur_under_min">أقل من دقيقة</string>
    <string name="dur_min">%1$d دقيقة</string>
    <string name="dur_h_min">%1$d ساعة و%2$d دقيقة</string>

    <!-- Up-front time estimate above Start. %1$s = a dur_* string. Deliberately worded as a FLOOR:
         every measurement behind it came from a flagship, so "at least" is the only honest framing. -->
    <string name="opt_eta_floor">المدة المتوقّعة على هذا الهاتف: ‏%1$s على الأقل.</string>

    <!-- Shown above a disabled Start when a job is already running; Naqi runs one job at a time. -->
    <string name="opt_job_running">هناك مهمة قيد التنفيذ بالفعل. انتظر حتى تنتهي أو ألغِها أوّلًا.</string>

    <!-- Confirm dialog shown when the estimate is long (Eta.CONFIRM_THRESHOLD_MS). A warning, never a
         refusal — its confirm button is action_start and its dismiss is action_cancel. %1$s = a dur_* string. -->
    <string name="dlg_long_job_title">ستستغرق هذه العملية وقتًا طويلًا</string>
    <string name="dlg_long_job_body">تُقدَّر مدة هذا الفيديو بنحو ‏%1$s على الأقل. أوصِل الهاتف بالشاحن — يواصل نقي العمل في الخلفية، لكن الهاتف سيبقى مشغولًا طوال هذه المدة، ولا يمكن إيقاف المهمة مؤقتًا، بل إلغاؤها فقط.</string>

    <!-- ============================================================
         Jobs / library — step 3, JobsScreen
         Also reuses action_cancel, action_open and action_share (see Notifications).
         ============================================================ -->

    <!-- Bottom-bar action that resets the flow back to step 1. -->
    <string name="jobs_new_job">فلترة فيديو آخر</string>

    <!-- Top-bar title of step 3: the queue, the running job and the library. -->
    <string name="jobs_title">النشاط</string>

    <!-- Empty state inside the job card when nothing is running, succeeded or failed. -->
    <!-- Phase 2 resume: shown on a failed long job whose finished segments are still on disk. -->
    <string name="jobs_resume_hint">تم الاحتفاظ بالأجزاء المكتملة من هذه المهمة. الاستئناف يكمل من حيث توقّفت.</string>
    <string name="action_resume">استئناف</string>
    <string name="jobs_none_running">لا توجد مهمة قيد التنفيذ.</string>

    <!-- Library list. "Movies/Naqi" is a real on-disk path — keep it Latin, untranslated. -->
    <string name="jobs_library">المكتبة</string>
    <string name="jobs_library_empty">تُحفظ مقاطع الفيديو المُفلترة في Movies/Naqi.</string>

    <!-- Progress card. jobs_stage_starting fills the instant before the worker publishes its first stage_* value. -->
    <string name="jobs_stage_starting">جارٍ البدء…</string>
    <!-- %1$d = 0–100 progress; ٪ (U+066A) is the Arabic percent sign, so no %% escape is needed here. -->
    <string name="jobs_progress_percent">%1$d٪</string>
    <!-- Live remaining time, refined from this device's observed rate. %1$s = a dur_* string.
         Hidden entirely until the worker has enough throughput to mean it (KEY_ETA_MS == 0). -->
    <string name="jobs_eta_remaining">يتبقّى نحو ‏%1$s</string>

    <!-- Success card. %1$s = the saved file name; the Movies/Naqi/ segment is a real path and stays Latin. -->
    <string name="jobs_saved_label">تم الحفظ</string>
    <string name="jobs_saved_path">Movies/Naqi/%1$s</string>

    <!-- Header of the system share sheet. -->
    <string name="jobs_share_chooser_title">مشاركة الفيديو</string>

    <!-- File-size subtitle on a library row. %1$.1f = gigabytes, %1$.0f = megabytes. -->
    <string name="jobs_size_gb">%1$.1f غيغابايت</string>
    <string name="jobs_size_mb">%1$.0f ميغابايت</string>

    <!-- ============================================================
         Dialogs and toasts — MainActivity
         ============================================================ -->

    <!-- Toasts after the delete-original flow resolves. -->
    <string name="dlg_original_deleted">تم حذف الملف الأصلي</string>
    <string name="dlg_original_kept">تم الإبقاء على الملف الأصلي</string>
    <string name="dlg_delete_original_failed">تعذّر حذف الملف الأصلي — احذفه من المعرض بدلًا من ذلك.</string>

    <!-- Confirm-delete dialog. %1$s = the file name of the filtered copy; it may fall back to dlg_delete_original_fallback_name. -->
    <string name="dlg_delete_original_title">حذف الملف الأصلي؟</string>
    <string name="dlg_delete_original_body">تبقى النسخة المُفلترة (%1$s) في Movies/Naqi. أمّا الفيديو الأصلي فسيُحذف من هذا الجهاز ولا يمكن استرجاعه.</string>
    <string name="dlg_delete_original_fallback_name">هذا الفيديو</string>
    <!-- Buttons of that dialog. Distinct from action_delete_original, the notification action. -->
    <string name="action_delete">حذف</string>
    <string name="action_keep">إبقاء</string>

    <!-- ============================================================
         Failure messages — the Preflight taxonomy, resolved in JobsScreen
         ============================================================ -->
    <string name="err_drm">هذا الفيديو محمي ضد النسخ (DRM)، لذا لا يمكن فلترته.</string>
    <string name="err_unreadable">تعذّر فتح هذا الملف. قد يكون تالفًا أو بصيغة لا يدعمها هذا الجهاز.</string>
    <string name="err_no_video">لا يحتوي هذا الملف على مسار فيديو.</string>
    <string name="err_no_audio">لا يحتوي هذا الفيديو على مسار صوتي، فلا توجد موسيقى لإزالتها.</string>
    <!-- The 2 GB figure is a fixed constant, not a format arg. -->
    <string name="err_low_space">لا توجد مساحة خالية كافية. تحتاج الفلترة إلى مساحة لنسخة مؤقتة إضافةً إلى نحو ٢ غيغابايت.</string>
    <string name="err_unsupported_codec">يستخدم هذا الفيديو ترميزًا لا يستطيع هذا الجهاز فكّه.</string>
    <string name="err_out_of_space">نفدت مساحة التخزين في الجهاز أثناء حفظ النسخة المُفلترة.</string>
    <!-- Catch-all. Also the JobsScreen fallback when a FAILED job carried no message. -->
    <string name="err_generic">فشلت الفلترة.</string>

    <!-- Download failures (M4). -->
    <string name="err_low_space_download">لا توجد مساحة كافية لتنزيل هذا الفيديو. فرّغ بعض المساحة ثم أعد المحاولة.</string>
    <string name="err_download_unsupported">لا يستطيع نقي التنزيل من هذا الرابط. قد يكون الموقع غير مدعوم أو الفيديو خاصًا.</string>
    <string name="err_download_network">فشل التنزيل. تحقّق من اتصالك ثم أعد المحاولة.</string>
    <string name="err_download_generic">فشل التنزيل.</string>

    <!-- ============================================================
         Notifications — job foreground service and the done notification.
         The action_* keys here are shared with JobsScreen and must keep these exact names.
         ============================================================ -->
    <string name="job_channel_name">فلترة الفيديو</string>
    <string name="job_channel_desc">تقدّم مهام الفلترة على الجهاز</string>
    <string name="job_notif_title">جارٍ فلترة الفيديو</string>
    <string name="action_cancel">إلغاء</string>
    <!-- Notification second line once an ETA exists. %1$s = a stage_* string, %2$s = a dur_* string.
         The notification is the only surface a user sees during a multi-hour job — the app is closed
         and the phone is locked — so the estimate has to reach here, not just the jobs screen. -->
    <string name="job_notif_stage_eta">%1$s · يتبقّى نحو ‏%2$s</string>
    <string name="stage_preparing">تجهيز الصوت</string>
    <string name="stage_analyzing">المرحلة ١ — التحليل</string>
    <string name="stage_rendering">المرحلة ٢ — المعالجة</string>
    <string name="stage_separating">إزالة الموسيقى</string>
    <string name="stage_muxing">اللمسات الأخيرة</string>
    <string name="stage_downloading">جارٍ التنزيل</string>

    <!-- ============================================================
         Share sheet (M4)
         ============================================================ -->
    <string name="share_loading">جارٍ قراءة تفاصيل الفيديو…</string>
    <string name="share_info_failed">تعذّرت قراءة هذا الفيديو. قد يكون خاصًا أو محجوبًا في منطقتك أو الموقع غير مدعوم.</string>
    <string name="share_untitled">فيديو مُشارَك</string>
    <string name="share_eyebrow_quality">الجودة</string>
    <string name="share_eyebrow_filters">الفلاتر</string>
    <string name="share_quality_best">الأفضل</string>
    <string name="share_quality_720">720p</string>
    <string name="share_quality_audio">الصوت فقط</string>
    <string name="action_download">تنزيل</string>
    <string name="action_filter">فلترة</string>
    <string name="action_retry">إعادة المحاولة</string>
    <string name="share_no_url">لم يُعثر على رابط في ما شاركته.</string>
    <string name="share_already_queued">موجود في القائمة بالفعل.</string>

    <!-- Share queue (M4). -->
    <string name="queue_eyebrow">القائمة</string>
    <string name="queue_state_pending_download">في انتظار التنزيل</string>
    <string name="queue_state_pending_filter">في انتظار الفلترة</string>
    <string name="queue_state_filtering">جارٍ الفلترة</string>
    <string name="queue_state_done">تم الحفظ</string>
    <string name="queue_state_failed">فشل</string>
    <string name="queue_dismiss">إخفاء</string>
    <string name="queue_clear_finished">مسح المكتملة</string>

    <!-- ============================================================
         About / open-source licences (M4). AboutScreen.
         ============================================================ -->
    <string name="about_title">عن نقي</string>
    <!-- %1$s = version name, %2$d = version code. -->
    <string name="about_version">الإصدار %1$s ‏(%2$d)</string>
    <!-- BRAND/LEGAL: the licence identifier stays Latin in every locale. -->
    <string name="about_license">مرخّص بموجب GPL-3.0-or-later.</string>
    <string name="about_open">عن التطبيق والتراخيص</string>

    <string name="about_eyebrow_downloader">أداة التنزيل</string>
    <string name="about_eyebrow_licenses">المصادر المفتوحة</string>
    <string name="about_ytdlp_version">yt-dlp ‏%1$s</string>
    <string name="about_ytdlp_unknown">لم يُحدَّث بعد</string>
    <string name="about_ytdlp_desc">تُغيّر المواقع طريقة تقديم الفيديو كل بضعة أسابيع. يتحقّق نقي من وجود أداة تنزيل أحدث مرة كل أسبوع؛ حدّثها من هنا إذا توقّف رابط عن العمل.</string>
    <string name="about_update">التحقّق من وجود تحديث</string>
    <string name="about_updating">جارٍ التحديث…</string>
    <string name="about_update_ok">أداة التنزيل محدّثة.</string>
    <string name="about_update_failed">تعذّر التحديث. تحقّق من اتصالك ثم أعد المحاولة.</string>
    <!-- Header of the collapsed licence block; action_show/action_hide are its two states. -->
    <string name="about_notices_title">إشعارات المصادر المفتوحة</string>
    <string name="about_notice_missing">إشعارات المصادر المفتوحة غير متوفّرة في هذه النسخة.</string>

    <!-- Ongoing notification while a download runs; the second line is the video title. -->
    <string name="download_notif_title">جارٍ تنزيل الفيديو</string>
    <string name="done_notif_title">تم حفظ النسخة المُفلترة</string>
